{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES6",
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "strictNullChecks": true,
    "importHelpers": true,
    "lib": ["ES2019", "DOM"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
